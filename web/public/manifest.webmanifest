{
  "name": "Pocket Renewals",
  "short_name": "Renewals",
  "description": "Everything that runs out, in one list: passports, insurance, warranties, domains, subscriptions, with reminders before each date.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#8c2f5a",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "Add something", "url": "/?add=1" },
    { "name": "Find in my apps", "url": "/find" },
    { "name": "Everything", "url": "/all" }
  ]
}
