[Unit]
Description=Pocket Renewals — everything that runs out
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-renewals
Group=pocket-renewals
ExecStart=/usr/local/bin/pocket-renewals
Environment=DATA_DIR=/var/lib/pocket-renewals
Environment=PORT=8080
Environment=BASE_URL=https://renewals.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-renewals
PrivateTmp=true

[Install]
WantedBy=multi-user.target
